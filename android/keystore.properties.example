# Release signing credentials — copy to `keystore.properties` and fill in.
#
#   cp android/keystore.properties.example android/keystore.properties
#
# The real keystore.properties and any *.jks / *.keystore file are git-ignored.
# NEVER commit them: the signing key cannot be rotated. If you lose it you can no
# longer publish updates to an existing app listing; if it leaks, anyone can sign
# builds that appear to be yours.
#
# storeFile is resolved relative to the android/ directory.

storeFile=bijli-release.jks
storePassword=CHANGE_ME
keyAlias=bijli
keyPassword=CHANGE_ME
